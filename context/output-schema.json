            }
          }
        },
        "tag_contract_nda": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "noul"
          ],
          "properties": {
            "type": {
              "const": "noul"
            },
            "noul": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "tag_contract_employment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
