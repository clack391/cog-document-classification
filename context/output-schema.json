{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Classification output",
  "description": "The payload under envelope v1's `payload` key. `$defs.decision` is authored with task_logic.decide; `$defs.answers` is derived from context/questions.json by `pixi run derive-schema` and checked for drift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "answers",
    "answered_by"
  ],
  "properties": {
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "answers": {
      "$ref": "#/$defs/answers"
    },
    "answered_by": {
      "$ref": "#/$defs/answered_by"
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "status",
        "document_type",
        "confidence",
        "tags",
        "flags",
        "reasons"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "classified",
            "needs_review"
          ]
        },
        "document_type": {
          "enum": [
            "invoice",
            "contract",
            "resume",
            "support_ticket",
            "other",
            null
          ],
          "description": "The assigned type; null when the document needs review."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The model's confidence in its top document type, also reported for documents in review."
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "contains_personal_data",
              "contains_financial_amounts",
              "time_sensitive",
              "signed",
              "draft_or_template",
              "multiple_documents",
              "non_english",
              "invoice_reminder",
              "invoice_credit_note",
              "contract_nda",
              "contract_employment",
              "contract_amendment",
              "ticket_urgent",
              "ticket_complaint",
              "ticket_billing",
              "ticket_bug_report"
            ]
          }
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "low-confidence",
              "illegible-text",
              "signals-disagree",
              "invoice-without-amounts"
            ]
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "answered_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "answer_source"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "answer_source": {
          "enum": [
            "system-one-model",
            "llm-adapter"
          ]
        }
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "text_legible",
        "tag_contains_personal_data",
        "tag_contains_financial_amounts",
        "tag_time_sensitive",
        "tag_signed",
        "tag_draft_or_template",
        "tag_multiple_documents",
        "tag_non_english",
        "tag_invoice_reminder",
        "tag_invoice_credit_note",
        "tag_contract_nda",
        "tag_contract_employment",
        "tag_contract_amendment",
        "tag_ticket_urgent",
        "tag_ticket_complaint",
        "tag_ticket_billing",
        "tag_ticket_bug_report"
      ],
      "properties": {
        "document_type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "choice",
            "probabilities",
            "confidence"
          ],
          "properties": {
            "type": {
              "const": "choice"
            },
            "choice": {
              "enum": [
                "invoice",
                "contract",
                "resume",
                "support_ticket",
                "other"
              ]
            },
            "probabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "invoice",
                "contract",
                "resume",
                "support_ticket",
                "other"
              ],
              "properties": {
                "invoice": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "contract": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "resume": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "support_ticket": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "other": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "text_legible": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "noul"
          ],
          "properties": {
            "type": {
              "const": "noul"
            },
            "noul": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "tag_contains_personal_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "noul"
          ],
          "properties": {
            "type": {
              "const": "noul"
            },
            "noul": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "tag_contains_financial_amounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "noul"
          ],
          "properties": {
            "type": {
              "const": "noul"
            },
            "noul": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "tag_time_sensitive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "noul"
          ],
          "properties": {
            "type": {
              "const": "noul"
            },
            "noul": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "tag_signed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "noul"
          ],
          "properties": {
            "type": {
              "const": "noul"
            },
            "noul": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "tag_draft_or_template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "noul"
          ],
          "properties": {
            "type": {
              "const": "noul"
            },
            "noul": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "tag_multiple_documents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
